{
  "$schema": "https://typedoc.org/schema.json",
  "plugin": [
    "typedoc-plugin-markdown",
    "typedoc-vitepress-theme",
    "./.vitepress/typedoc/index.mjs"
  ],
  "theme": "idetik",
  "entryPoints": ["src/index.ts"],
  "tsconfig": "tsconfig.json",
  "out": "docs/api",
  "docsRoot": "docs",
  "readme": ".vitepress/api-index.md",
  "mergeReadme": true,
  "githubPages": false,
  "navigation": {
    "includeGroups": true
  },
  "groupOrder": [
    "Constructors",
    "Type Aliases",
    "Properties",
    "Accessors",
    "Methods",
    "*"
  ],
  "sort": ["source-order"],
  "router": "idetik",
  "typeAliasPropertiesFormat": "table",
  "pageTitleTemplates": {
    "member": "{name}"
  },
  "hidePageHeader": true,
  "hideBreadcrumbs": true,
  "tableColumnSettings": {
    "hideSources": true
  },
  "useCodeBlocks": true,
  "expandObjects": true,
  "parametersFormat": "table",
  "sidebar": {
    "autoConfiguration": true,
    "pretty": true
  }
}
